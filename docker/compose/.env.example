# Docker Compose Integration Stack Environment Variables
# Copy this file to .env and customize as needed
# Note: .env files are typically gitignored for security

# =============================================================================
# OTEL Collector Ports
# =============================================================================
# OTLP HTTP endpoint for sending telemetry data
OBSERVE_KIT_INTEGRATION_OTEL_COLLECTOR_OTLP_HTTP_PORT=4318

# OTLP gRPC endpoint for sending telemetry data
OBSERVE_KIT_INTEGRATION_OTEL_COLLECTOR_OTLP_GRPC_PORT=4317

# Collector metrics endpoint (for Prometheus scraping)
OBSERVE_KIT_INTEGRATION_OTEL_COLLECTOR_DEBUG_PORT=8888

# Health check endpoint
OBSERVE_KIT_INTEGRATION_OTEL_COLLECTOR_HEALTH_PORT=13133

# pprof endpoint for Go profiling
OBSERVE_KIT_INTEGRATION_OTEL_COLLECTOR_PPROF_PORT=1777

# zpages endpoint for live debugging
OBSERVE_KIT_INTEGRATION_OTEL_COLLECTOR_ZPAGES_PORT=55679

# =============================================================================
# Other Service Ports
# =============================================================================
# Prometheus web UI and API
OBSERVE_KIT_INTEGRATION_PROMETHEUS_PORT=9090

# HyperDX web UI
OBSERVE_KIT_INTEGRATION_HYPERDX_PORT=8080

# ClickHouse HTTP interface (shifted from 8123 to avoid conflicts)
OBSERVE_KIT_INTEGRATION_CLICKHOUSE_HTTP_PORT=28123

# ClickHouse native protocol (shifted from 9000 to avoid conflicts)
OBSERVE_KIT_INTEGRATION_CLICKHOUSE_NATIVE_PORT=29000

# MongoDB port
OBSERVE_KIT_INTEGRATION_MONGODB_PORT=27017

# =============================================================================
# Environment Configuration
# =============================================================================
# Telemetry environment tag (integration, development, production, etc.)
TELEMETRY_ENVIRONMENT=integration

# Service version tag for telemetry
SERVICE_VERSION=dev

# =============================================================================
# HyperDX Configuration
# =============================================================================
# Default admin user credentials (for local development only!)
# ⚠️  CHANGE THESE IN PRODUCTION!
# Note: Password must be 12+ chars, upper+lower case, special char
HYPERDX_ADMIN_EMAIL=admin@example.com
HYPERDX_ADMIN_NAME=admin
HYPERDX_ADMIN_PASSWORD=Admin123!@#$

# Default team configuration
HYPERDX_TEAM_NAME=Default Team
HYPERDX_TEAM_SLUG=default
