# Copy to docker/compose/.env to override defaults locally.

GLITCHTIP_PORT=8080
GLITCHTIP_POSTGRES_PORT=5433
GLITCHTIP_REDIS_PORT=6379
GLITCHTIP_DOMAIN=http://localhost:8080
GLITCHTIP_SECRET_KEY=local-dev-glitchtip-secret-key-change-me
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@example.com
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_POSTGRES_DB=glitchtip
GLITCHTIP_POSTGRES_USER=glitchtip
GLITCHTIP_POSTGRES_PASSWORD=glitchtip
